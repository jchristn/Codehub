{
  "webserver": {
    "hostname": "127.0.0.1",
    "port": 8090,
    "ssl": false,
    "enableOpenApi": true
  },
  "cors": {
    "enable": true,
    "allowOrigin": "*",
    "allowMethods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
    "allowHeaders": "Content-Type, Authorization, X-Api-Key"
  },
  "authentication": {
    "apiKey": "codehub-dev-key"
  },
  "database": {
    "type": "Sqlite",
    "filename": "data/codehub.db"
  },
  "directories": {
    "rootPaths": [ "C:\\Code" ],
    "excludeDirectories": [ "bin", "obj", "node_modules", "dist", ".git", ".vs", "packages", "TestResults" ]
  },
  "scan": {
    "intervalHours": 6,
    "scanOnStartup": true,
    "maxConcurrency": 8,
    "dependencyCheck": true
  },
  "github": {
    "personalAccessToken": "",
    "owner": "jchristn"
  },
  "logging": {
    "consoleLogging": true,
    "enableColors": true,
    "fileLogging": true,
    "logDirectory": "logs",
    "logFilename": "codehub.log",
    "minimumSeverity": 1
  },
  "requestHistory": {
    "enabled": true,
    "maxRequestBodyBytes": 65536,
    "maxResponseBodyBytes": 65536,
    "retentionDays": 30
  },
  "modelRunner": {
    "endpointBaseUrl": "",
    "apiType": "OpenAI",
    "apiKey": "",
    "modelName": ""
  }
}
