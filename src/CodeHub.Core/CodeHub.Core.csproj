<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>CodeHub.Core</AssemblyName>
    <RootNamespace>CodeHub.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>CodeHub</Product>
    <Title>CodeHub Core</Title>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Description>Core library for CodeHub: repository discovery, health-signal collectors, scoring, and the SQLite persistence layer.</Description>
    <Copyright>Copyright (c) 2026 Joel Christner</Copyright>
    <PackageProjectUrl>https://github.com/jchristn/codehub</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/codehub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageTags>repository;health;dashboard;devtools;monitoring</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PrettyId" Version="2.0.1" />
    <PackageReference Include="SyslogLogging" Version="2.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE.md')" />
  </ItemGroup>

</Project>
